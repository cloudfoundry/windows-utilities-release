$ErrorActionPreference = "Stop"

<% require "base64" -%>
$KmsEnabled=[bool]$<%= p("set_kms_host.enabled").to_s.downcase != "false" %>
$EncodedHost='<%= Base64.strict_encode64(p("set_kms_host.host").to_s) %>'
$DesiredHost=[System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($EncodedHost))
$DesiredPort=<%= Integer(p("set_kms_host.port").to_s, 10) %>

If (-Not $KmsEnabled) {
  "set_kms_host.enabled equals false, nothing to do."
  Exit 0
}

$InboundRule="Open inbound $DesiredPort for KMS Server"
if ((Get-NetFirewallRule | where { $_.DisplayName -eq $InboundRule }) -ne $null) {
    "Deleting inbound firewall rule for KMS"
    netsh advfirewall firewall delete rule name=$InboundRule
}

"Creating inbound firewall rule for KMS"
netsh advfirewall firewall add rule name=$InboundRule dir=in action=allow protocol=TCP localport=$DesiredPort


$OutboundRule="Open outbound $DesiredPort for KMS Server"
if ((Get-NetFirewallRule | where { $_.DisplayName -eq $OutboundRule }) -ne $null) {
    "Deleting outbound firewall rule for KMS"
    netsh advfirewall firewall delete rule name=$OutboundRule
}

"Creating outbound firewall rule for KMS"
netsh advfirewall firewall add rule name=$OutboundRule dir=out action=allow protocol=TCP remoteport=$DesiredPort

# slmgr.vbs /skms fails with 0x80041008 on stemcells whose sppwmi.dll is
# 10.0.17763.9479. It writes these same two values, and activation reads them.
$SppKey='HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\SoftwareProtectionPlatform'
"Setting KMS host in the registry: {0}:{1}" -f $DesiredHost,$DesiredPort
New-ItemProperty -Path $SppKey -Name KeyManagementServiceName -Value $DesiredHost -PropertyType String -Force | Out-Null
New-ItemProperty -Path $SppKey -Name KeyManagementServicePort -Value "$DesiredPort" -PropertyType String -Force | Out-Null
